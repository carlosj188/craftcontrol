# CraftControl — copie para .env e preencha.
#
#     cp .env.example .env && ./instalar.sh
#
# O instalar.sh gera os segredos sozinho. Se preferir à mão, troque tudo que
# está como "troque-me". Nunca versione o .env.

# ---------- obrigatórios ----------

# Senha do RCON do seu servidor. Precisa ser a MESMA do server.properties
# (ou da variável RCON_PASSWORD do contêiner, se você usa a imagem itzg).
# Deixe-a fixa: se o servidor gerar uma nova a cada boot, o painel perde acesso.
RCON_PASSWORD=troque-me

# Assina os tokens de sessão do painel. Qualquer string longa e aleatória.
JWT_SECRET=troque-me

# Login do painel. Esta conta é sempre ADMINISTRADORA e não pode ser removida
# nem rebaixada pela tela de usuários — é a chave-mestra: se você esquecer a
# senha de um usuário criado no painel, é por aqui que se entra para arrumar.
# Guarde bem: quem tem este .env entra como admin.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-me

# Outros usuários (operador, leitor) são criados DENTRO do painel, na aba
# Atividade. Ficam num arquivo, não aqui.

# Por quantos dias guardar o histórico de "quem fez o quê". Padrão: 90.
# EVENTOS_DIAS=90

# Onde guardar usuários e histórico do painel. Vazio = usa a mesma pasta de
# dados do servidor (MC_DATA), que é o suficiente para quase todo mundo.
# PANEL_DATA=/mcdata

# ---------- seu servidor ----------

# Onde estão os dados do servidor (a pasta com world/, mods/, logs/).
# Caminho no HOST. Precisa ser gravável pelo uid 1000.
MC_DATA=./data

# Onde guardar os backups automáticos. Precisa ser gravável pelo uid 1000.
# 7 cópias de um mundo de 1 GB ocupam ~4 GB — confira o espaço antes de ligar.
BACKUP_DIR=./backups

# Nome do contêiner do Minecraft — usado para ligar/desligar pelo painel.
MC_CONTAINER=minecraft

# Nome do serviço do Minecraft na rede do Docker, para o RCON.
MC_HOST=mc
MC_RCON_PORT=25575

# Só aparência, no topo do painel.
MC_NAME=Meu Servidor
MC_ADDRESS=

# ---------- opcionais ----------

PANEL_PORT=8095
TZ=America/Sao_Paulo

# Desliga a consulta ao Modrinth (nome de catálogo, aviso de atualização e a
# busca de mods). O painel funciona sem ela, só sem enriquecimento.
# MODS_ONLINE=false

# A API do Modrinth pede um User-Agent que identifique quem chama. Se você for
# usar bastante, ponha um com contato próprio.
# MODRINTH_UA=SeuNome/craftcontrol (seu@email)

# Com mais de um servidor, acrescente a senha RCON de cada um e aponte para ela
# pela chave "senhaEnv" dentro do MC_SERVERS, no compose.yaml:
# RCON_PASSWORD_CRIATIVO=troque-me
